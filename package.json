{
  "name": "evidgate",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=26 <27"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && npm run build -w apps/web",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run e2e --workspaces --if-present",
    "codegen": "openapi-ts -f openapi-ts.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "{apps/web,packages}/**/*.{ts,tsx}": [
      "prettier --check",
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "apps/web/**/*.html": [
      "prettier --check",
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "*.{json,yaml,yml,js,mjs,cjs}": [
      "prettier --check"
    ],
    "*.cs": [
      "dotnet format Evidgate.slnx --verify-no-changes --include"
    ]
  },
  "scarfSettings": {
    "enabled": false
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/css": "2.0.1",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@stoplight/spectral-cli": "6.17.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "license-checker-rseidelsohn": "5.0.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@angular/forms": {
      "zod": "4.6.7"
    }
  }
}
