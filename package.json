{
  "name": "evidgate",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=26 <27"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run e2e --workspaces --if-present",
    "codegen": "echo 'SDK codegen lands with 01.3.2-T1; no-op keeps the ci.yml drift gate honest' && exit 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "{apps/web,packages}/**/*.{ts,tsx}": [
      "prettier --check",
      "eslint --max-warnings 0"
    ],
    "*.{json,yaml,yml,js,mjs,cjs}": [
      "prettier --check"
    ],
    "*.cs": [
      "dotnet format Evidgate.slnx --verify-no-changes --include"
    ]
  },
  "scarfSettings": {
    "enabled": false
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@stoplight/spectral-cli": "6.16.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "license-checker-rseidelsohn": "5.0.1",
    "lint-staged": "17.5.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
