{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability.v1.json",
  "title": "Adapter capability document v1",
  "description": "00 §10 adapter protocol capability document. The server rejects an incompatible protocol.major. See contracts/README.md for the *.vN.json versioning rule.",
  "type": "object",
  "required": ["protocol", "engine", "platforms", "supports", "mode"],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "type": "object",
      "required": ["major", "minor"],
      "additionalProperties": false,
      "properties": {
        "major": { "type": "integer", "minimum": 1 },
        "minor": { "type": "integer", "minimum": 0 }
      }
    },
    "engine": {
      "type": "object",
      "required": ["family", "version"],
      "additionalProperties": false,
      "properties": {
        "family": { "type": "string", "maxLength": 64 },
        "version": { "type": "string", "maxLength": 128 }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 64 }
    },
    "supports": {
      "type": "object",
      "required": ["discovery", "step_events", "retry", "cancel"],
      "additionalProperties": false,
      "properties": {
        "discovery": { "type": "boolean" },
        "step_events": { "type": "boolean" },
        "retry": { "type": "boolean" },
        "cancel": { "type": "boolean" }
      }
    },
    "mode": {
      "type": "string",
      "enum": ["full", "ingest_only"],
      "description": "ingest_only results are viewable but not gate-eligible unless the manifest is proven complete (00 §10)"
    }
  }
}
