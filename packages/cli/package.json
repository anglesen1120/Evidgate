{
  "name": "@evidgate/cli",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "evidgate": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/embed-contracts.mjs && tsc -b",
    "embed:contracts": "node scripts/embed-contracts.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@evidgate/sdk": "*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
