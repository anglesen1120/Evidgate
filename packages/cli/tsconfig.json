{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    // 01.3.2-T4.2: src/canonical.ts imports node:crypto. Nothing in the build program
    // pulls @types/node in (the specs get it through vitest/config's
    // /// <reference types="node" />, which is why only this project needs the entry).
    "types": ["node"]
  },
  "include": ["src"],
  // 01.6.1-T1.2: specs and the Vitest config are type-checked by tsconfig.spec.json and
  // must never be emitted into dist. Referencing that project is not valid for `tsc -b`
  // (a referenced project must be composite *and* emit — TS6306/TS6310), so
  // eslint.config.js points the parser at it explicitly instead.
  // A `*.testing.ts` module (a fixture the specs share, such as the dev-token exchange
  // stub) is not a spec, but it is test-only all the same: the package ships `dist`, so
  // this project must not emit it either — tsconfig.spec.json is what types it.
  "exclude": ["src/**/*.test.ts", "src/**/*.testing.ts", "vitest.config.ts"],
  // 01.3.2-T1.2: @evidgate/sdk workspace dependency — the build must see its emitted
  // declarations (npm workspaces links it via node_modules).
  "references": [{ "path": "../sdk" }, { "path": "../variant" }]
}
