{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    // 04.3.1-T1.1: the reporter reads @playwright/test/package.json (node:module
    // createRequire) and writes the spool (node:fs/node:crypto/node:path). Same
    // reasoning as packages/cli's canonical.ts — only this project needs the
    // @types/node entry; the specs get it through vitest.config.base.mts.
    "types": ["node"]
  },
  "include": ["src"],
  // 01.6.1-T1.2: specs and the Vitest config are type-checked by tsconfig.spec.json and
  // must never be emitted into dist. The fixture modules the specs share (`*.testing.ts`)
  // are test-only too, so they stay out of the shipped `dist` as well.
  "exclude": ["src/**/*.test.ts", "src/**/*.testing.ts", "vitest.config.ts"],
  // 04.3.3-T2.2: @evidgate/cli workspace dependency — the build must see its emitted
  // declarations (src/attach.ts types against the CLI's attachment facade,
  // `createAttachmentUploader`/`AttachmentUploader`, which wraps `uploadFile()`; npm
  // workspaces links it via node_modules). The dependency is one-way: packages/cli never
  // references the adapter.
  "references": [{ "path": "../cli" }, { "path": "../variant" }]
}
