<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The contract schema set code-generates and Roslyn-compiles its validators at runtime (Corvus
         Json.Validator); the compile assets only reach deps.json with this property, exactly as
         tests/Contract.Tests.csproj documents for its own host. -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="dbup-postgresql" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <!-- seed-dev with the token switch drives the modules' own commands through Mediator, so the
       generator runs here (as in both entry points) and the container below is built
       from the same shared extensions (DevSeedServices). -->
  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Mediator.SourceGenerator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <!-- 10.1.1-T2: the connection string resolves through ISecretProvider, which
         lives in SharedKernel (dependency-free, so no package graph is added). -->
    <ProjectReference Include="..\BuildingBlocks\SharedKernel\Evidgate.BuildingBlocks.SharedKernel.csproj" />
    <!-- seed-dev with the token switch: the tenant's ingest token and sample policy are minted by the
         real commands, never by a second copy of the credential or policy logic. -->
    <ProjectReference Include="..\Modules\Evidgate.Modules.Identity\Evidgate.Modules.Identity.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Modules\Evidgate.Modules.Policy\Evidgate.Modules.Policy.csproj" PrivateAssets="all" />
    <!-- seed-dev's base run: the dev project's case, suite and suite revision are written by the Catalog
         module's own service and commands, so a manifest has a real suite revision to name. -->
    <ProjectReference Include="..\Modules\Evidgate.Modules.Catalog\Evidgate.Modules.Catalog.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The redactor and the options' ToString are internal by design (00 §5.7 S3);
         the integration suite asserts that no secret can reach a message or a log.
         10.1.1-T2: MigratorOptions.ConnectionString has an internal setter so no
         binder can write the secret; the suites whose fixtures build MigratorOptions
         directly (tests/Shared/DatabaseFixture.cs is linked into Foundation and
         Identity) see it here. -->
    <InternalsVisibleTo Include="Migrator.IntegrationTests" />
    <InternalsVisibleTo Include="Foundation.IntegrationTests" />
    <InternalsVisibleTo Include="Hosts.IntegrationTests" />
    <InternalsVisibleTo Include="Identity.IntegrationTests" />
    <InternalsVisibleTo Include="Isolation.Tests" />
    <InternalsVisibleTo Include="Persistence.IntegrationTests" />
    <InternalsVisibleTo Include="Tasks.IntegrationTests" />
    <InternalsVisibleTo Include="Tenancy.IntegrationTests" />
  </ItemGroup>
</Project>
