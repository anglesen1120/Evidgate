<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Evidgate.Modules.Authoring</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />
    <!-- 13.1.1-T1.4: EF Core 10 write model (00 §5.5 C4); no EF migrations, the schema is plain SQL in migrations/. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Evidgate.Modules.Authoring.Contracts\Evidgate.Modules.Authoring.Contracts.csproj" />
    <!-- 13.1.1-T5.2: the XLSX import/export reads its workbook parts through the 06.3.1 parser profile
         (IParsing.ReadArchiveEntries), the sanctioned module-to-module route: exactly the .Contracts
         project, never another module's implementation (00 §5.5 C7, Architecture.Tests). -->
    <ProjectReference Include="..\Evidgate.Modules.Evidence.Contracts\Evidgate.Modules.Evidence.Contracts.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\SharedKernel\Evidgate.BuildingBlocks.SharedKernel.csproj" />
    <!-- 13.1.1-T1.4: the read model runs on Dapper (C1) and the write model on EF Core, both through this block. -->
    <ProjectReference Include="..\..\BuildingBlocks\Persistence\Evidgate.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Pipeline\Evidgate.BuildingBlocks.Pipeline.csproj" />
    <!-- 13.1.1-T1.2: contracts/schemas/authoring-steps.v1.json is validated through Corvus. -->
    <ProjectReference Include="..\..\BuildingBlocks\Contracts.Validation\Evidgate.BuildingBlocks.Contracts.Validation.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Observability\Evidgate.BuildingBlocks.Observability.csproj" />
    <!-- 13.1.1-T1.3: content_hash and the order hash are RFC 8785 canonical hashes (00 §7). -->
    <ProjectReference Include="..\..\BuildingBlocks\Canonicalization\Evidgate.BuildingBlocks.Canonicalization.csproj" />
  </ItemGroup>
  <!-- 01.1.2-T2.1: internal implementation, opened to the two composition roots and the tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Evidgate.Api" />
    <InternalsVisibleTo Include="Evidgate.Worker" />
    <InternalsVisibleTo Include="Hosts.IntegrationTests" />
    <InternalsVisibleTo Include="Tenancy.IntegrationTests" />
  </ItemGroup>
</Project>
