<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Evidgate.Modules.Identity</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />
    <!-- 02.2.1-T2.2: EF Core 10 write model (00 §5.5 C4) of the flagged custom-role
         commands, like the Tenancy module's 02.1.1-T1.3 model. Relational carries
         ToTable/HasCheckConstraint; no EF migrations are generated (the schema is
         plain SQL in migrations/). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- 02.1.2-T1.2: the membership commands' shape validators (C2 stage 2). The
         version is the solution's single pinned one (Directory.Packages.props); the
         pipeline already uses it, so no licence is added. -->
    <PackageReference Include="FluentValidation" />
    <!-- 02.4.1-T1/T3.3: GitHub OIDC validation and the minted ci_producer JWT (D7). Already
         pinned in Directory.Packages.props; MIT. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>
  <!--
    02.2.1-T1.2: this module owns public minimal-API routes (00 §5.5 `Endpoints/`,
    §5.2 "the Api composes module endpoints"), so it needs the ASP.NET Core shared
    framework — a framework reference, not a package: nothing is pinned and the lock
    file is unaffected. `Architecture.Tests` allows public types only in a
    `…Contracts`/`…Endpoints` namespace, which is the shape the routes take.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Evidgate.Modules.Identity.Contracts\Evidgate.Modules.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\SharedKernel\Evidgate.BuildingBlocks.SharedKernel.csproj" />
    <!-- 02.2.1-T1.2: the Dapper read path over the ambient tenant scope (00 §5.5 C5). -->
    <ProjectReference Include="..\..\BuildingBlocks\Persistence\Evidgate.BuildingBlocks.Persistence.csproj" />
    <!-- 02.2.1-T2.2: the C2 authorization seam the module implements
         (IPermissionEvaluator, IRequestPrincipal, PermissionDecision) and the
         ambient request tenant its evaluator reads. -->
    <ProjectReference Include="..\..\BuildingBlocks\Pipeline\Evidgate.BuildingBlocks.Pipeline.csproj" />
    <!-- 02.2.1-T1.2: the module-level span of the read handlers, like every other
         module that owns handlers (Orchestrator, Ingestion, Policy). -->
    <ProjectReference Include="..\..\BuildingBlocks\Observability\Evidgate.BuildingBlocks.Observability.csproj" />
  </ItemGroup>
  <!--
    01.1.2-T2.1: the module implementation stays internal (00 §5.5), so the two
    composition roots and the integration tests see the composition seam through
    InternalsVisibleTo — one deliberate escape hatch instead of making domain code
    public. 02.2.1-T1.2 adds Identity.IntegrationTests, which drives the read
    queries and the catalogue RLS from the real registration.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Evidgate.Api" />
    <InternalsVisibleTo Include="Evidgate.Worker" />
    <InternalsVisibleTo Include="Hosts.IntegrationTests" />
    <InternalsVisibleTo Include="Identity.IntegrationTests" />
    <InternalsVisibleTo Include="Tenancy.IntegrationTests" />
    <InternalsVisibleTo Include="Tasks.IntegrationTests" />
  </ItemGroup>
</Project>
