<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Evidgate.Modules.Usage</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tenant route maps from the module, the shape every /v1 module follows. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Evidgate.Modules.Usage.Contracts\Evidgate.Modules.Usage.Contracts.csproj" />
    <!-- The billing operator's reads answer 404 for an org that does not exist, through the registry's Contracts
         surface; a module never reads another module's tables. -->
    <ProjectReference Include="..\Evidgate.Modules.Tenancy.Contracts\Evidgate.Modules.Tenancy.Contracts.csproj" />
    <!-- The AI-token half of a tenant's cost is Healing's ledger: the query asks its Contracts seam for the month
         rather than reading `healing_llm_call` across the module boundary. -->
    <ProjectReference Include="..\Evidgate.Modules.Healing.Contracts\Evidgate.Modules.Healing.Contracts.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\SharedKernel\Evidgate.BuildingBlocks.SharedKernel.csproj" />
    <!-- The issued statement's content hash is taken over the shared RFC 8785 canonical form, not a local one. -->
    <ProjectReference Include="..\..\BuildingBlocks\Canonicalization\Evidgate.BuildingBlocks.Canonicalization.csproj" />
    <!-- 12.3.1-T1.4: the ledger write is raw Npgsql SQL over the module's EF DbContext/tenant transaction (00 §5.5 C3/C5). -->
    <ProjectReference Include="..\..\BuildingBlocks\Persistence\Evidgate.BuildingBlocks.Persistence.csproj" />
    <!-- 12.3.1-T1.4: the handler's span carries the `usage` module tag (01.1.2-T1.2). -->
    <ProjectReference Include="..\..\BuildingBlocks\Observability\Evidgate.BuildingBlocks.Observability.csproj" />
    <!-- The tenant summary is a Mediator query, so the module carries the C2 pipeline's permission gate and the
         tenant/principal accessors it reads, the same reference every module with a /v1 route has. -->
    <ProjectReference Include="..\..\BuildingBlocks\Pipeline\Evidgate.BuildingBlocks.Pipeline.csproj" />
  </ItemGroup>
  <!-- 12.3.1-T1.3: internal implementation, opened to the two composition roots and the tests (01.1.2-T2.1). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Evidgate.Api" />
    <InternalsVisibleTo Include="Evidgate.Worker" />
    <InternalsVisibleTo Include="Hosts.IntegrationTests" />
    <InternalsVisibleTo Include="Tenancy.IntegrationTests" />
  </ItemGroup>
</Project>
