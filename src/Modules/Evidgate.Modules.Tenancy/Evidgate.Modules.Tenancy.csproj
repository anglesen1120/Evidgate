<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Evidgate.Modules.Tenancy</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />
    <!-- 02.1.1-T1.3: EF Core 10 write model (00 §5.5 C4). Relational carries
         ToTable/HasCheckConstraint; no EF migrations are generated (schema is
         plain SQL in migrations/). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- 02.1.1-T2.1: the org/project commands' shape validators (C2 stage 2), the
         solution's single pinned FluentValidation (the Identity module uses it too). -->
    <PackageReference Include="FluentValidation" />
  </ItemGroup>
  <!--
    02.1.1-T2.2: the module owns public minimal-API routes (00 §5.5 `Endpoints/`), so
    it needs the ASP.NET Core shared framework — a framework reference, not a package,
    exactly like the Identity module.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Evidgate.Modules.Tenancy.Contracts\Evidgate.Modules.Tenancy.Contracts.csproj" />
    <!-- 02.1.1-T2.1 (AC8, T98): the founder membership is Identity's table, written
         through its exported IOrganizationFounder contract (00 §5.5: modules talk
         through .Contracts only). -->
    <ProjectReference Include="..\Evidgate.Modules.Identity.Contracts\Evidgate.Modules.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\SharedKernel\Evidgate.BuildingBlocks.SharedKernel.csproj" />
    <!-- 02.1.1-T2: the tenant scope, ITenantDb (Dapper read path) and the EF context factory. -->
    <ProjectReference Include="..\..\BuildingBlocks\Persistence\Evidgate.BuildingBlocks.Persistence.csproj" />
    <!-- 02.1.1-T2: the request principal (project scope guard, AC4) and the request tenant
         the POST /v1/orgs endpoint publishes for the org it creates. -->
    <ProjectReference Include="..\..\BuildingBlocks\Pipeline\Evidgate.BuildingBlocks.Pipeline.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Observability\Evidgate.BuildingBlocks.Observability.csproj" />
  </ItemGroup>
  <!--
    01.1.2-T2.1: the module implementation stays internal (00 §5.5), so the two
    composition roots and the integration tests see the entities, the EF
    configurations and the composition seam through InternalsVisibleTo — one
    deliberate escape hatch instead of making domain code public. 01.4.2's
    DbContext factory registers the IEntityTypeConfiguration classes from this
    assembly the same way.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Evidgate.Api" />
    <InternalsVisibleTo Include="Evidgate.Worker" />
    <InternalsVisibleTo Include="Hosts.IntegrationTests" />
    <InternalsVisibleTo Include="Tenancy.IntegrationTests" />
  </ItemGroup>
</Project>
