<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Evidgate.Modules.Evidence.Contracts</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- 06.3.1-T1: IParsing returns Result/Result<T> (00 §5.5 C8), the shape every business handler
         returns, so 04.4.1's parser callers map the outcome straight to the 00 §9.2 envelope.
         SharedKernel is a BuildingBlock, not a module, so the reference keeps the module-to-module
         rule (00 §5.5) intact (same shape as Evidgate.Modules.Ingestion.Contracts). -->
    <ProjectReference Include="..\..\BuildingBlocks\SharedKernel\Evidgate.BuildingBlocks.SharedKernel.csproj" />
  </ItemGroup>
  <!-- 06.3.1-T1: ParsedXmlReport's constructor is internal — only the parser profile may construct one
       (the factory must be the profile's own closed reader factory) — so the Evidence module's
       Infrastructure/Parsing profile sees it through InternalsVisibleTo. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Evidgate.Modules.Evidence" />
  </ItemGroup>
</Project>
