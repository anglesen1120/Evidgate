<Project Sdk="Microsoft.NET.Sdk">
  <!-- 01.4.1 T1/T4: Migrator apply/journal/checksum/dry-run/status + expand/contract playbook tests (Testcontainers.PostgreSQL).
       Not named Evidgate.* so the Architecture.Tests reflection scan never picks it up. -->
  <PropertyGroup>
    <RootNamespace>Migrator.IntegrationTests</RootNamespace>
  </PropertyGroup>
  <!-- OutputType, Microsoft.NET.Test.Sdk, xunit.v3, xunit.runner.visualstudio, Shouldly
       and NSubstitute come from tests/Directory.Build.props (01.6.1-T1.1). -->
  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSQL" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Evidgate.Migrator\Evidgate.Migrator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\ContainerImages.cs" Link="ContainerImages.cs" />
    <Content Include="Fixtures\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
