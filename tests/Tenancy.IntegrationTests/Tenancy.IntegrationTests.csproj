<Project Sdk="Microsoft.NET.Sdk">
  <!-- 02.1.1-T1: organization/project schema + RLS (0004/0005), the real Migrator forward run,
       the DTO contract and the EF write-model mapping (Testcontainers.PostgreSQL).
       Not named Evidgate.* so the Architecture.Tests reflection scan never picks it up.
       OutputType, the xUnit/Shouldly/NSubstitute references and IsTestProject come from
       tests/Directory.Build.props (01.6.1-T1.1); container and EF packages stay here. -->
  <PropertyGroup>
    <RootNamespace>Tenancy.IntegrationTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSQL" />
    <PackageReference Include="Npgsql" />
    <!-- WriteModelMappingTests builds the real EF Core model over the Npgsql provider. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- 02.1.1-T2: the registry routes run through the real Api composition. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- The collection-deadline sweep drives the real schedule runner at a controlled instant. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <!-- The suite bootstraps as superuser and applies the real migrations through the
         Migrator as evidgate_owner (02.1.1-T1.4). -->
    <ProjectReference Include="..\..\src\Evidgate.Migrator\Evidgate.Migrator.csproj" />
    <!-- WriteModelMappingTests builds the model through the production path:
         a context derived from EvidgateDbContext with UseTenantModel (01.4.2-T1.3). -->
    <ProjectReference Include="..\..\src\BuildingBlocks\Persistence\Evidgate.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Tenancy.Contracts\Evidgate.Modules.Tenancy.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Tenancy\Evidgate.Modules.Tenancy.csproj" />
    <!-- 03.1.1: the catalog routes and the case-identity service run through the same host and database. -->
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Catalog\Evidgate.Modules.Catalog.csproj" />
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Catalog.Contracts\Evidgate.Modules.Catalog.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Orchestrator\Evidgate.Modules.Orchestrator.csproj" />
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Orchestrator.Contracts\Evidgate.Modules.Orchestrator.Contracts.csproj" />
    <!-- 07.1.1-T1: the policy revision store and its EF write model run through the same host and database. -->
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Policy\Evidgate.Modules.Policy.csproj" />
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Healing\Evidgate.Modules.Healing.csproj" />
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Healing.Contracts\Evidgate.Modules.Healing.Contracts.csproj" />
    <!-- 06.1.1-T1: the evidence artifact write model runs through the same host and database. -->
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Evidence\Evidgate.Modules.Evidence.csproj" />
    <!-- 04.7.1-T2: the ingestion capability store, negotiator and first-send seam run through the same host and database. -->
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Ingestion\Evidgate.Modules.Ingestion.csproj" />
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Ingestion.Contracts\Evidgate.Modules.Ingestion.Contracts.csproj" />
    <!-- 13.1.1: the authoring tree, its version writer and the code allocator run through the same host and database. -->
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Authoring\Evidgate.Modules.Authoring.csproj" />
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Authoring.Contracts\Evidgate.Modules.Authoring.Contracts.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Contracts.Validation\Evidgate.BuildingBlocks.Contracts.Validation.csproj" />
    <!-- 12.3.1-T1.4: the ledger write path (one-statement batch insert, dedupe, 422 rules) through the same host and database. -->
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Usage\Evidgate.Modules.Usage.csproj" />
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Usage.Contracts\Evidgate.Modules.Usage.Contracts.csproj" />
    <!-- 02.1.1-T2: the endpoint suites drive Program (ApiHost) through WebApplicationFactory. -->
    <ProjectReference Include="..\..\src\Evidgate.Api\Evidgate.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\ContainerImages.cs" Link="ContainerImages.cs" />
    <Compile Include="..\Shared\ContainerStart.cs" Link="ContainerStart.cs" />
    <Compile Include="..\Shared\ContainerStartReaper.cs" Link="ContainerStartReaper.cs" />
    <Compile Include="..\Shared\ContractSchemaWarmup.cs" Link="ContractSchemaWarmup.cs" />
    <Compile Include="..\Shared\PurgeLeaseGuardTestExtensions.cs" Link="PurgeLeaseGuardTestExtensions.cs" />
    <Compile Include="..\Shared\TemplateDatabase.cs" Link="TemplateDatabase.cs" />
    <Compile Include="..\Shared\LeanLibraryMetrics.cs" Link="LeanLibraryMetrics.cs" />
    <Compile Include="..\Shared\NoForwardedProxy.cs" Link="NoForwardedProxy.cs" />
    <Compile Include="..\Shared\NoHealingProvider.cs" Link="NoHealingProvider.cs" />
    <Compile Include="..\Shared\TransientS3Retry.cs" Link="TransientS3Retry.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bounded class-level parallelism (4 workers): more workers can overload a small Postgres container VM (copy timeouts, 100 ms regex guard trips). -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
