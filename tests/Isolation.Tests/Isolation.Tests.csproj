<Project Sdk="Microsoft.NET.Sdk">
  <!-- 01.4.1 T2/T3: role privileges, RLS helpers and cross-tenant isolation (Testcontainers.PostgreSQL); extended by 01.6.1-T4.
       Not named Evidgate.* so the Architecture.Tests reflection scan never picks it up. -->
  <PropertyGroup>
    <RootNamespace>Isolation.Tests</RootNamespace>
  </PropertyGroup>
  <!-- OutputType, Microsoft.NET.Test.Sdk, xunit.v3, xunit.runner.visualstudio, Shouldly
       and NSubstitute come from tests/Directory.Build.props (01.6.1-T1.1). -->
  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSQL" />
    <PackageReference Include="Npgsql" />
    <!-- 01.6.1-T4: the shared harness (DatabaseFixture/RespawnCheckpoint) and the EF Core
         write-model probe over public.project (migrations 0004/0005). -->
    <PackageReference Include="Respawn" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- 02.9.1-T1: the API isolation suite drives Program (ApiHost) through WebApplicationFactory. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <!-- 01.6.1-T4.2: the in-process host of the test-only /v1 tenant route. A non-web
       project reaches ASP.NET Core through the shared framework, never through a
       PackageReference to a framework package. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- The isolation suite bootstraps as superuser and then applies the real
         migrations through the Migrator as evidgate_owner (01.4.1 §9). -->
    <ProjectReference Include="..\..\src\Evidgate.Migrator\Evidgate.Migrator.csproj" />
    <!-- 01.6.1-T4: the production tenancy registration (ITenantScope/ITenantDb,
         01.4.2) the task isolation is asserted through, and the public ProjectDto the
         Dapper read and the test-only route materialise. -->
    <ProjectReference Include="..\..\src\BuildingBlocks\Persistence\Evidgate.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Tenancy.Contracts\Evidgate.Modules.Tenancy.Contracts.csproj" />
    <!-- 02.9.1-T1: the API isolation suite runs the real host (Program → ApiHost) and seeds
         test cases through the public case-identity service (no POST /v1 route for cases). -->
    <ProjectReference Include="..\..\src\Evidgate.Api\Evidgate.Api.csproj" />
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Catalog.Contracts\Evidgate.Modules.Catalog.Contracts.csproj" />
    <!-- 13.1.1-T2: the authoring tree is org- and project-scoped, so its isolation route cases
         seed through this module's public contracts exactly as the catalog ones do. -->
    <ProjectReference Include="..\..\src\Modules\Evidgate.Modules.Authoring.Contracts\Evidgate.Modules.Authoring.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\ContainerImages.cs" Link="ContainerImages.cs" />
    <Compile Include="..\Shared\ContainerStart.cs" Link="ContainerStart.cs" />
    <Compile Include="..\Shared\ContractSchemaWarmup.cs" Link="ContractSchemaWarmup.cs" />
    <Compile Include="..\Shared\TemplateDatabase.cs" Link="TemplateDatabase.cs" />
    <!-- 01.6.1-T2: the shared harness is linked source, exactly as
         tests/Foundation.IntegrationTests adopts it (tests/README.md). -->
    <Compile Include="..\Shared\DatabaseFixture.cs" Link="Shared/DatabaseFixture.cs" />
    <Compile Include="..\Shared\RespawnCheckpoint.cs" Link="Shared/RespawnCheckpoint.cs" />
    <Compile Include="..\Shared\TenantTestScope.cs" Link="Shared/TenantTestScope.cs" />
    <Compile Include="..\Shared\HarnessTest.cs" Link="Shared/HarnessTest.cs" />
    <Compile Include="..\Shared\NoForwardedProxy.cs" Link="NoForwardedProxy.cs" />
    <Compile Include="..\Shared\NoHealingProvider.cs" Link="NoHealingProvider.cs" />
  </ItemGroup>
</Project>
