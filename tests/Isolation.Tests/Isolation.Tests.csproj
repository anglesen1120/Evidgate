<Project Sdk="Microsoft.NET.Sdk">
  <!-- 01.4.1 T2/T3: role privileges, RLS helpers and cross-tenant isolation (Testcontainers.PostgreSQL); extended by 01.6.1-T4.
       Not named Evidgate.* so the Architecture.Tests reflection scan never picks it up. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Isolation.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.PostgreSQL" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <!-- The isolation suite bootstraps as superuser and then applies the real
         migrations through the Migrator as evidgate_owner (01.4.1 §9). -->
    <ProjectReference Include="..\..\src\Evidgate.Migrator\Evidgate.Migrator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\ContainerImages.cs" Link="ContainerImages.cs" />
  </ItemGroup>
</Project>
