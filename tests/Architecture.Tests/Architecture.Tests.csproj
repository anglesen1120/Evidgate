<Project Sdk="Microsoft.NET.Sdk">
  <!--
    01.2.1-T1.2: enforces the 00 §5.5 module shape and §5.7 S2 pipeline-authorization
    rules. The assembly is deliberately NOT named Evidgate.* so the reflection scan
    (Evidgate.*.dll in the output directory) never picks up its own fixtures.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Architecture.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>
  <!--
    Every Evidgate.* production project in Evidgate.slnx must be ProjectReferenced
    here so its assembly lands in this project's output directory and is scanned by
    the reflection rules. ModuleBoundariesTests.Test_Project_References_All_Slnx_Projects
    keeps this list in sync when 01.1.2+ adds module projects.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Evidgate.Api\Evidgate.Api.csproj" />
    <ProjectReference Include="..\..\src\Evidgate.Worker\Evidgate.Worker.csproj" />
    <ProjectReference Include="..\..\src\Evidgate.Migrator\Evidgate.Migrator.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\SharedKernel\Evidgate.BuildingBlocks.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Persistence\Evidgate.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Canonicalization\Evidgate.BuildingBlocks.Canonicalization.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Contracts.Validation\Evidgate.BuildingBlocks.Contracts.Validation.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Observability\Evidgate.BuildingBlocks.Observability.csproj" />
  </ItemGroup>
</Project>
