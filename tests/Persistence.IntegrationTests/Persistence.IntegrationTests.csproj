<Project Sdk="Microsoft.NET.Sdk">
  <!-- 01.4.2-T1: tenant scope, EF/Dapper binding and the interceptor guard (AC1-AC3, AC6) on
       Testcontainers.PostgreSQL, with migrations applied by the real Evidgate.Migrator.
       Not named Evidgate.* so the Architecture.Tests reflection scan never picks it up.
       The xUnit/Shouldly package set and OutputType live in tests/Directory.Build.props (01.6.1-T1.1). -->
  <PropertyGroup>
    <RootNamespace>Persistence.IntegrationTests</RootNamespace>
    <!-- The Migrator reference below is aliased, so the linked template helper routes its
         migration types through the same alias instead of the global namespace. -->
    <DefineConstants>$(DefineConstants);EVIDGATE_MIGRATOR_ALIASED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSQL" />
    <PackageReference Include="Npgsql" />
    <!-- 01.4.2-T4: the pipeline tests drive the real generated mediator of this
         assembly (Mediator.SourceGenerator), its behaviours and FluentValidation. -->
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Mediator.SourceGenerator" PrivateAssets="all" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BuildingBlocks\Persistence\Evidgate.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Pipeline\Evidgate.BuildingBlocks.Pipeline.csproj" />
    <!-- Aliased: the Migrator carries its own generated mediator, which would collide with this project's. -->
    <ProjectReference Include="..\..\src\Evidgate.Migrator\Evidgate.Migrator.csproj" Aliases="migrator" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\ContainerImages.cs" Link="ContainerImages.cs" />
    <Compile Include="..\Shared\ContainerStart.cs" Link="ContainerStart.cs" />
    <Compile Include="..\Shared\TemplateDatabase.cs" Link="TemplateDatabase.cs" />
  </ItemGroup>
</Project>
