{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src"],
  // Specs and the Vitest config are type-checked by tsconfig.spec.json and never emitted.
  "exclude": ["src/**/*.test.ts", "vitest.config.ts"]
}
