# Evidgate dev environment template (01.8.1-T2.1). scripts/dev/up.sh copies this
# file to .env.dev on first run, replaces every __...__ placeholder with a fresh
# random value and chmods the result 600. .env.dev is git-ignored (00 §5.7 S3) and
# is the only place dev credentials live — never commit it, never put a real
# credential in this template.
#
# Read by scripts/dev/up.sh (which sources and exports it), and inherited by the
# compose stack, Evidgate.Api, Evidgate.Worker and Evidgate.Migrator. Nothing in
# this stack is reachable off-host: every port below is bound to 127.0.0.1.
# Full quickstart: docs/dev-setup.md.

# --- stack ports (loopback only) ---
EVIDGATE_DB_PORT=5432
EVIDGATE_S3_PORT=8333
# ASPNETCORE_URLS is the Api's HTTP endpoint; the Worker serves readiness on its
# own port. Changing a port here means changing the matching connection string
# below as well (up.sh does not rewrite them).
ASPNETCORE_URLS=http://127.0.0.1:8080
EVIDGATE__WORKER__HEALTHPORT=8081

# --- environments (dev stack is Development; 00 §11: never in production) ---
DOTNET_ENVIRONMENT=Development
ASPNETCORE_ENVIRONMENT=Development

# --- compose Postgres superuser: bootstrap only, the app never uses it ---
EVIDGATE_DB_SUPERUSER_PASSWORD=__EVIDGATE_DB_SUPERUSER_PASSWORD__

# --- database roles (01.4.1-T2: owner migrates, app serves, operator reads,
# --- worker_sched sweeps) ---
EVIDGATE_OWNER_PASSWORD=__EVIDGATE_OWNER_PASSWORD__
EVIDGATE_APP_PASSWORD=__EVIDGATE_APP_PASSWORD__
EVIDGATE_OPERATOR_PASSWORD=__EVIDGATE_OPERATOR_PASSWORD__
EVIDGATE_WORKER_SCHED_PASSWORD=__EVIDGATE_WORKER_SCHED_PASSWORD__

# --- Api and Worker: the app role, subject to RLS (never the owner) ---
EVIDGATE__DATABASE__CONNECTIONSTRING='Host=127.0.0.1;Port=5432;Database=evidgate;Username=evidgate_app;Password=__EVIDGATE_APP_PASSWORD__'

# --- Evidgate.Migrator: the owner role, the only writer of public.schema_migration ---
EVIDGATE_MIGRATOR__CONNECTIONSTRING='Host=127.0.0.1;Port=5432;Database=evidgate;Username=evidgate_owner;Password=__EVIDGATE_OWNER_PASSWORD__'

# --- Worker sweeps: the evidgate_worker_sched role, the only role with EXECUTE on
# --- the owner SECURITY DEFINER sweeps (TL T80, e.g. the scheduled
# --- idempotency.purge). Without it the Worker still consumes ordinary tasks and
# --- the sweep task fails loudly, naming this key, in its task.last_error.
EVIDGATE__TASKS__SWEEPCONNECTIONSTRING='Host=127.0.0.1;Port=5432;Database=evidgate;Username=evidgate_worker_sched;Password=__EVIDGATE_WORKER_SCHED_PASSWORD__'

# --- local object storage (ADR-0004 / CR-01-1: SeaweedFS) ---
# up.sh uses these coordinates to create the bucket and put the pending/ 24 h
# lifecycle rule on it (T18). The identity is the local-only test one and MUST
# equal infra/seaweedfs/s3-config.json (the 01.8.1-T1 parity suite reads that
# file); up.sh refuses to start when the two drift apart.
EVIDGATE_S3_ENDPOINT=http://127.0.0.1:8333
EVIDGATE_S3_REGION=us-east-1
EVIDGATE_S3_BUCKET=evidgate-dev
EVIDGATE_S3_ACCESS_KEY=evidgate-local-test-only-access-key
EVIDGATE_S3_SECRET_KEY=evidgate-local-test-only-secret-key