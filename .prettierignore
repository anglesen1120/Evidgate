fixtures/contracts/vectors/event-envelope.v1/acc-04-batch-max-500.json
fixtures/contracts/vectors/event-envelope.v1/acc-05-max-bytes-exact.json
fixtures/contracts/vectors/event-envelope.v1/rej-15-batch-501-items.json
fixtures/contracts/vectors/event-envelope.v1/rej-16-over-max-bytes.json
fixtures/contracts/vectors/event-envelope.v1/rej-01-invalid-json.json

