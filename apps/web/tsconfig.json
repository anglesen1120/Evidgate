{
  // 09.1.1-T1.1 (00 §5.6 W1/W2): the application compiler project. `tsc -p apps/web/tsconfig.app.json`
  // is not part of any gate — the Angular builder compiles with its own options — but the file
  // is the project the ESLint project service resolves for `apps/web/src/**` non-spec files,
  // so the strict flags of tsconfig.base.json apply from the first source file.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 00 §5.6 W1: the browser bundles the sources itself — Node's resolution does not apply.
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "dom"],
    "types": [],
    // The builder emits through its own pipeline; `tsc` must never write next to the sources.
    "noEmit": true,
    "isolatedModules": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true
  },
  "angularCompilerOptions": {
    // W2: strict templates, no `any` leaking through a template binding.
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "extendedDiagnostics": {
      "defaultCategory": "error"
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
