{
  // 01.2.1-T3.2: apps/web is part of the tsc -b project-reference graph so the
  // strict flags in tsconfig.base.json apply from the first source file.
  // Angular (09.x) replaces this with tsconfig.app.json/tsconfig.spec.json
  // extending ../../tsconfig.base.json.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
