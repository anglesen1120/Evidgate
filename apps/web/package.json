{
  "name": "@evidgate/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "start:fixtures": "ng serve --configuration fixtures",
    "build": "ng build && node scripts/check-bundle-budget.mjs && node scripts/check-no-fixture-code.mjs",
    "test": "ng test --watch=false && vitest run --config eslint-rules/vitest.config.mts && node --test scripts/",
    "i18n:extract": "ng extract-i18n",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "e2e": "npm run build && playwright test",
    "build:fixtures:e2e": "ng build --configuration fixtures --localize=true --output-path dist/fixtures",
    "e2e:fixtures": "playwright test -c playwright.fixtures.config.ts"
  },
  "dependencies": {
    "@angular/cdk": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/localize": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/router": "22.2.0",
    "@evidgate/sdk": "*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@evidgate/cli": "*",
    "@evidgate/test-fixtures": "*",
    "@playwright/test": "1.63.0",
    "angular-eslint": "22.5.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "rollup": "4.65.0"
  }
}
