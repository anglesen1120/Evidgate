{
  "name": "@evidgate/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "start:fixtures": "ng serve --configuration fixtures",
    "build": "ng build && node scripts/check-bundle-budget.mjs && node scripts/check-no-fixture-code.mjs",
    "build:review": "ng build --configuration review && node scripts/check-bundle-budget.mjs && node scripts/check-no-fixture-code.mjs --allow-dev-sign-in --require-run-views",
    "test": "node scripts/check-a11y-exceptions.mjs && ng test --watch=false && vitest run --config eslint-rules/vitest.config.mts && node --test scripts/",
    "test:a11y": "node scripts/check-a11y-exceptions.mjs && ng test --watch=false --include='**/*.a11y.spec.ts'",
    "test:e2e:a11y": "node scripts/check-a11y-exceptions.mjs && playwright test -c playwright.core.config.ts e2e/core/a11y.spec.ts",
    "check:a11y-exceptions": "node scripts/check-a11y-exceptions.mjs",
    "i18n:extract": "ng extract-i18n",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "e2e": "npm run build && playwright test",
    "build:fixtures:e2e": "ng build --configuration fixtures --localize=true --output-path dist/fixtures",
    "e2e:fixtures": "playwright test -c playwright.fixtures.config.ts",
    "build:core:e2e": "ng build --configuration fixtures --localize=true",
    "e2e:core": "playwright test -c playwright.core.config.ts"
  },
  "dependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/localize": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@evidgate/sdk": "*",
    "@ngrx/signals": "22.0.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@spartan-ng/brain": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.7.1",
    "tslib": "2.9.1",
    "tw-animate-css": "1.4.0",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@evidgate/cli": "*",
    "@evidgate/test-fixtures": "*",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "angular-eslint": "22.8.0",
    "axe-core": "4.14.1",
    "jsdom": "30.1.3",
    "postcss": "8.5.33",
    "rollup": "4.68.7",
    "tailwindcss": "4.3.5"
  }
}
