{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": "en",
        "locales": {
          "vi": {
            "translation": "src/locale/messages.vi.xlf"
          }
        }
      },
      "schematics": {
        "@schematics/angular:component": {
          "changeDetection": "OnPush",
          "standalone": true,
          "style": "css"
        },
        "@schematics/angular:directive": {
          "standalone": true
        },
        "@schematics/angular:pipe": {
          "standalone": true
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "polyfills": ["@angular/localize/init"],
            "styles": ["src/styles.css"],
            "assets": [],
            "outputPath": "dist",
            "i18nMissingTranslation": "error"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "900kB"
                },
                {
                  "type": "anyScript",
                  "maximumWarning": "300kB",
                  "maximumError": "450kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "12kB"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "localize": ["en", "vi"]
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false,
              "localize": ["vi"],
              "fileReplacements": [
                {
                  "replace": "src/app/core/dev-routes/dev-routes.ts",
                  "with": "src/app/core/dev-routes/dev-routes.fixtures.ts"
                }
              ]
            },
            "fixtures": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false,
              "localize": ["vi"],
              "fileReplacements": [
                {
                  "replace": "src/app/core/dev-fixtures/dev-backend.ts",
                  "with": "src/app/core/dev-fixtures/dev-backend.fixtures.ts"
                },
                {
                  "replace": "src/app/core/dev-routes/dev-routes.ts",
                  "with": "src/app/core/dev-routes/dev-routes.fixtures.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "web:build:development",
            "format": "xlf",
            "outputPath": "src/locale"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "web:build:production"
            },
            "development": {
              "buildTarget": "web:build:development"
            },
            "fixtures": {
              "buildTarget": "web:build:fixtures"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "web:build:development",
            "runner": "vitest",
            "tsConfig": "tsconfig.spec.json",
            "include": ["src/**/*.spec.ts"],
            "exclude": ["e2e/**"],
            "reporters": [
              ["default", {}],
              ["junit", { "outputFile": "test-results/junit.xml" }]
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
