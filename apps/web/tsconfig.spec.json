{
  // 09.1.1-T1.1 (00 §5.6 W9): everything the gates type-check but never emit — the Angular
  // component specs run by `ng test` (Vitest, zoneless TestBed), the Playwright config and
  // the E2E specs (Playwright transpiles without type-checking, so this project is their
  // only gate). scripts/verify.sh runs `npx tsc -p apps/web/tsconfig.spec.json` (tsc-spec),
  // and eslint.config.js points the parser for these files at this project.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The builder's Vitest runner sets `globals: true` (describe/it/expect without imports);
    // `node` is needed by playwright.config.ts (`process.env`) and by the ESLint rule spec
    // (node:fs/node:url to read tokens.css and locate the repository root). 09.1.1-T6.1: the
    // spec project compiles the same `i18n` templates, so it needs the ambient `$localize`
    // global too.
    "types": ["vitest/globals", "node", "@angular/localize"],
    // 09.1.1-T11.4: the ESLint rule spec runs under Vitest through
    // `eslint-rules/vitest.config.mts`, which imports the shared base by its real `.mts`
    // path (the Vitest native config loader does not remap `.js` specifiers onto `.mts`).
    // tsc only allows that extension spelling under noEmit.
    "allowImportingTsExtensions": true
  },
  // tsconfig.json excludes specs from the application project; this project exists to
  // type-check exactly those, so the inherited `exclude` must not apply here.
  "exclude": [],
  "include": [
    "src/**/*.spec.ts",
    "playwright.config.ts",
    // 09.1.1-T4.4: the fixtures-config Playwright suite (the shell's real-browser gate). Named
    // explicitly because `**/playwright.config.ts` does not match `playwright.fixtures.config.ts`.
    "playwright.fixtures.config.ts",
    "e2e/**/*.ts",
    // 09.1.1-T11.4 (AC9): the `style-tokens` rule spec and its Vitest config. The rule
    // itself is plain CommonJS (`eslint-rules/*.js`) linted by ESLint, not type-checked.
    "eslint-rules/**/*.spec.ts",
    "eslint-rules/vitest.config.mts"
  ]
}
