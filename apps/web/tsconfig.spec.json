{
  // 01.6.1-T1.2: type-checks the specs and the Vitest config without emitting, so they
  // stay out of the dist build (see `exclude` in tsconfig.json). eslint.config.js points
  // the parser for `*.test.ts` and `vitest.config.ts` at this file.
  // The Angular workspace (09.1.1-T2) will move component specs into this project too.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // The workspace config imports the shared base by its real `.mts` path: the
    // Vitest native config loader (Node ESM) does not remap `.js`/`.mjs` specifiers
    // to the `.mts` source, and tsc only allows the `.mts` extension under noEmit.
    "allowImportingTsExtensions": true
  },
  // 01.6.1-T5.1: the Playwright config and the E2E specs are outside the emitting
  // `tsconfig.json` (`include: ["src"]`), and Playwright transpiles without type-checking,
  // so this project is the only gate for them — same role as for the Vitest specs.
  "include": [
    "src/**/*.test.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "../../vitest.config.base.mts"
  ]
}
