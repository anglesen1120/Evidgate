# Evidgate.Migrator container image — 10.2.1-T1.2, AC5.
#
# A separate image on the same pins as the Api/Worker images (ruling T41): the
# deploy runs it as a one-shot job with the owner-role connection string
# (10.2.2-T1, FR-10-3). It is never a second tag on the Api or Worker image —
# different Dockerfile, different published project, different entry point.
#
#   scripts/build-images.sh --platform linux/arm64 --image migrator
#   docker buildx build --platform linux/arm64 -f infra/docker/Dockerfile.migrator \
#     --load -t evidgate-migrator:dev .
#
# It applies plain-SQL migrations (DbUp 7) and preserves the CLI contract of
# 01.4.1 §5, including the read-only `--status` command the deploy gate reads
# (10.2.2-T1).

FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0.100@sha256:c7445f141c04f1a6b454181bd098dcfa606c61ba0bd213d0a702489e5bd4cd71 AS build

ARG TARGETARCH
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props global.json nuget.config ./
# .editorconfig: the analyzer severities the repository gate enforces
# (VSTHRD200 = suggestion, VSTHRD002 = error, ...) — without it the container
# build would apply the analyzers' default severities instead.
COPY .editorconfig ./
COPY src/ ./src/
RUN dotnet restore --locked-mode src/Evidgate.Migrator/Evidgate.Migrator.csproj

# No PublishReadyToRun: 00 §5.7 P7 names the long-lived Api/Worker processes,
# and a one-shot tool gains nothing from a crossgen pass it pays for in bytes.
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) rid=x64 ;; \
      arm64) rid=arm64 ;; \
      *) echo "unsupported TARGETARCH '$TARGETARCH': 00 §11 supports linux/amd64 and linux/arm64 only" >&2; exit 1 ;; \
    esac; \
    dotnet publish src/Evidgate.Migrator/Evidgate.Migrator.csproj \
      --configuration Release \
      --no-restore \
      --runtime "linux-$rid" \
      --self-contained false \
      --output /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0.12-noble-chiseled@sha256:9651fa59abcdf177c30392cb44a820605ca5d618429ab37acbf6e7c644510b02 AS runtime

# The migration set ships inside the image: the deploy must not depend on a
# mounted repository (the mounted-file failure mode measured by 01.8.1-T2 —
# infra/README.md). EVIDGATE_MIGRATOR__MIGRATIONSPATH is the documented override
# (MigratorOptions): the default path resolution walks up looking for
# Evidgate.slnx, which does not exist in an image, so the path is explicit here.
ENV EVIDGATE_MIGRATOR__MIGRATIONSPATH=/app/migrations

USER $APP_UID
WORKDIR /app
COPY --from=build --chown=$APP_UID:$APP_UID /app ./
COPY --chown=$APP_UID:$APP_UID migrations/ /app/migrations/

# Args append to the entry point, so `docker run <image> --status` runs
# `dotnet /app/Evidgate.Migrator.dll --status` (AC5, 10.2.1-T1.2), `--dry-run`
# and `--help` likewise. No shell is involved: the chiseled image has none.
ENTRYPOINT ["/usr/bin/dotnet", "/app/Evidgate.Migrator.dll"]
