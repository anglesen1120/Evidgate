# Evidgate.Worker container image — 10.2.1-T1.1, ruling T41, 01 §13 CR-01-3.
#
# Build it through scripts/build-images.sh (which also runs the AC1 checks):
#   scripts/build-images.sh --platform linux/arm64 --image worker
# Direct equivalent:
#   docker buildx build --platform linux/arm64 -f infra/docker/Dockerfile.worker \
#     --load -t evidgate-worker:dev .
#
# Same builder pin, same build strategy and the same non-root chiseled runtime as
# Dockerfile.api except for the runtime *variant*: the Worker keeps the plain
# `-chiseled` base because it never composes the authoring module and stays
# globalization-invariant, while the Api needs the `-extra` variant's ICU
# (13.1.1-T2, D-S55-Q1). Otherwise the two entry points differ only in the
# project they publish, the exposed port and the assembly they start.
#
# 06.3.6-T1.3: this image publishes TWO processes — the Worker at /app and its
# parse child (`Evidgate.Parser`, the only process that touches untrusted bytes)
# at /app/parser, which the parent runner starts as
# `dotnet /app/parser/Evidgate.Parser.dll`. The child gets its own output
# directory on purpose: both publishes emit the SharedKernel and Evidence
# contracts assemblies plus their own runtimeconfig.json/deps.json, so a shared
# --output would have one publish overwrite the other's dependency files and the
# loser would fail at run time with no build error. The child is a short-lived
# process, so it is published without `PublishReadyToRun` for the reason
# Dockerfile.migrator states: 00 §5.7 P7 names the long-lived Api/Worker
# processes for crossgen, and a process that starts per parse only pays those
# bytes. It stays on the same plain chiseled base, because
# `Directory.Build.props` puts `Evidgate.Parser` in the Worker's
# InvariantGlobalization group (06.3.6-T1.2).
#
# Carried by 08.4.1-T3.3 (ruling T36): the pinned Node runtime that
# packages/healing-validator needs. That package does not exist yet, so this
# image deliberately carries no Node layer — a layer with no consumer could not
# be verified (no spawn path, nothing to run), and 08.4.1-T3.3 owns the pin.
# Add it there, next to these pins, in the runtime stage below.

FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0.100@sha256:c7445f141c04f1a6b454181bd098dcfa606c61ba0bd213d0a702489e5bd4cd71 AS build

ARG TARGETARCH
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props global.json nuget.config ./
# .editorconfig: the analyzer severities the repository gate enforces
# (VSTHRD200 = suggestion, VSTHRD002 = error, ...) — without it the container
# build would apply the analyzers' default severities instead.
COPY .editorconfig ./
COPY src/ ./src/
# Same two build inputs as Dockerfile.api (Persistence embeds
# contracts/rls-exceptions.txt and bakes the migrations/*.sql head).
COPY contracts/ ./contracts/
COPY migrations/ ./migrations/
RUN dotnet restore --locked-mode -p:PublishReadyToRun=true src/Evidgate.Worker/Evidgate.Worker.csproj
# The parse child is restored WITHOUT that flag because it is published without
# it (header: 00 §5.7 P7 names the long-lived Api/Worker processes, the same rule
# Dockerfile.migrator states for its one-shot tool), and a plain restore keeps the
# restore inputs identical to the R2R-free publish. Not because locked mode would
# reject the flag: no lock file in this repository carries a crossgen pack — the
# Worker is restored with it against exactly such a lock.
RUN dotnet restore --locked-mode src/Evidgate.Parser/Evidgate.Parser.csproj

RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) rid=x64 ;; \
      arm64) rid=arm64 ;; \
      *) echo "unsupported TARGETARCH '$TARGETARCH': 00 §11 supports linux/amd64 and linux/arm64 only" >&2; exit 1 ;; \
    esac; \
    dotnet publish src/Evidgate.Worker/Evidgate.Worker.csproj \
      --configuration Release \
      --no-restore \
      --runtime "linux-$rid" \
      --self-contained false \
      -p:PublishReadyToRun=true \
      --output /app; \
    dotnet publish src/Evidgate.Parser/Evidgate.Parser.csproj \
      --configuration Release \
      --no-restore \
      --runtime "linux-$rid" \
      --self-contained false \
      --output /app/parser

FROM mcr.microsoft.com/dotnet/aspnet:10.0.12-noble-chiseled@sha256:9651fa59abcdf177c30392cb44a820605ca5d618429ab37acbf6e7c644510b02 AS runtime

USER root
WORKDIR /app
# One COPY: /app/parser (the parse child's dll, runtimeconfig.json and deps.json) travels with the Worker output.
# Deliberately NO `--chown`, and the directory is created as root before the USER switch: the tree stays
# root-owned (a publish writes 0644 files and 0755 directories) and only world-readable, so the non-root runtime
# can read and start both processes but cannot unlink or replace an assembly. Both halves matter — a root-owned
# file inside a directory the app uid owns can be unlinked and replaced by that uid, and BuildKit creates a missing
# WORKDIR with the ownership of whichever USER is active.
# The parse child is the one process that touches untrusted bytes: a compromised child runs as $APP_UID, and a
# writable /app would let it swap the Worker's own binaries for the next start or a sibling process (06.3.6 review,
# security finding). Nothing in the Worker writes under its base directory — temp input for a parse run goes to
# ParseRunnerOptions.TempRoot (/tmp by default) — so root ownership costs nothing.
COPY --from=build /app ./
USER $APP_UID

# 01.1.2-T1.1: the Worker's readiness surface is its own HTTP listener on
# EVIDGATE__WORKER__HEALTHPORT (default 8081) serving /internal/health/live and
# /internal/health/ready; the Worker has no ASP.NET Core pipeline, so the port is
# a plain TCP listener. It is configurable, so it is documented, not baked.
EXPOSE 8081

ENTRYPOINT ["/usr/bin/dotnet", "/app/Evidgate.Worker.dll"]
