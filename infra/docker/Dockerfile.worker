# Evidgate.Worker container image — 10.2.1-T1.1, ruling T41, 01 §13 CR-01-3.
#
# Build it through scripts/build-images.sh (which also runs the AC1 checks):
#   scripts/build-images.sh --platform linux/arm64 --image worker
# Direct equivalent:
#   docker buildx build --platform linux/arm64 -f infra/docker/Dockerfile.worker \
#     --load -t evidgate-worker:dev .
#
# Same builder pin, same build strategy and the same non-root chiseled runtime as
# Dockerfile.api except for the runtime *variant*: the Worker keeps the plain
# `-chiseled` base because it never composes the authoring module and stays
# globalization-invariant, while the Api needs the `-extra` variant's ICU
# (13.1.1-T2, D-S55-Q1). Otherwise the two entry points differ only in the
# project they publish, the exposed port and the assembly they start.
#
# Carried by 08.4.1-T3.3 (ruling T36): the pinned Node runtime that
# packages/healing-validator needs. That package does not exist yet, so this
# image deliberately carries no Node layer — a layer with no consumer could not
# be verified (no spawn path, nothing to run), and 08.4.1-T3.3 owns the pin.
# Add it there, next to these pins, in the runtime stage below.

FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0.100@sha256:c7445f141c04f1a6b454181bd098dcfa606c61ba0bd213d0a702489e5bd4cd71 AS build

ARG TARGETARCH
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props global.json nuget.config ./
# .editorconfig: the analyzer severities the repository gate enforces
# (VSTHRD200 = suggestion, VSTHRD002 = error, ...) — without it the container
# build would apply the analyzers' default severities instead.
COPY .editorconfig ./
COPY src/ ./src/
# Same two build inputs as Dockerfile.api (Persistence embeds
# contracts/rls-exceptions.txt and bakes the migrations/*.sql head).
COPY contracts/ ./contracts/
COPY migrations/ ./migrations/
RUN dotnet restore --locked-mode -p:PublishReadyToRun=true src/Evidgate.Worker/Evidgate.Worker.csproj

RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) rid=x64 ;; \
      arm64) rid=arm64 ;; \
      *) echo "unsupported TARGETARCH '$TARGETARCH': 00 §11 supports linux/amd64 and linux/arm64 only" >&2; exit 1 ;; \
    esac; \
    dotnet publish src/Evidgate.Worker/Evidgate.Worker.csproj \
      --configuration Release \
      --no-restore \
      --runtime "linux-$rid" \
      --self-contained false \
      -p:PublishReadyToRun=true \
      --output /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0.12-noble-chiseled@sha256:9651fa59abcdf177c30392cb44a820605ca5d618429ab37acbf6e7c644510b02 AS runtime

USER $APP_UID
WORKDIR /app
COPY --from=build --chown=$APP_UID:$APP_UID /app ./

# 01.1.2-T1.1: the Worker's readiness surface is its own HTTP listener on
# EVIDGATE__WORKER__HEALTHPORT (default 8081) serving /internal/health/live and
# /internal/health/ready; the Worker has no ASP.NET Core pipeline, so the port is
# a plain TCP listener. It is configurable, so it is documented, not baked.
EXPOSE 8081

ENTRYPOINT ["/usr/bin/dotnet", "/app/Evidgate.Worker.dll"]
