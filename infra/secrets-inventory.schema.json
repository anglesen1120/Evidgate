{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidgate.invalid/infra/secrets-inventory.schema.json",
  "title": "Evidgate secret inventory",
  "description": "Names, owners, stores and cadences of secrets. No field may hold a value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "soleOperator", "secrets", "open"],
  "properties": {
    "//": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "const": 1
    },
    "soleOperator": {
      "type": "boolean"
    },
    "soleOperatorNote": {
      "type": "string",
      "maxLength": 200
    },
    "open": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "receiver"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "text": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300
          },
          "receiver": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        }
      }
    },
    "secrets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "owner",
          "store",
          "rotationDays",
          "lastRotated",
          "breakGlassHolder",
          "runbook",
          "cadenceBasis"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^EVIDGATE[A-Z0-9_]*$"
          },
          "owner": {
            "type": "string",
            "pattern": "^(owner|[A-Z][a-z]+( [A-Z][a-z]+)+)$"
          },
          "breakGlassHolder": {
            "type": "string",
            "pattern": "^(owner|[A-Z][a-z]+( [A-Z][a-z]+)+)$"
          },
          "store": {
            "enum": ["env-injection", "secret-store", "sealed-offline"]
          },
          "generator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {
                "enum": [
                  "random-hex",
                  "random-base64",
                  "connection-string",
                  "template-provided",
                  "not-generated"
                ]
              },
              "role": {
                "type": "string",
                "pattern": "^evidgate_[a-z_]+$"
              },
              "reason": {
                "type": "string",
                "maxLength": 200
              }
            }
          },
          "rotationDays": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 3650
          },
          "lastRotated": {
            "type": ["string", "null"],
            "format": "date"
          },
          "lastRotatedReason": {
            "type": "string",
            "pattern": "\\S",
            "minLength": 10,
            "maxLength": 200
          },
          "runbook": {
            "type": "string",
            "pattern": "^docs/runbooks/[a-z0-9-]+\\.md(#[a-z0-9-]+)?$"
          },
          "cadenceBasis": {
            "type": "string",
            "maxLength": 200
          },
          "external": {
            "type": "boolean"
          }
        },
        "if": {
          "properties": {
            "lastRotated": {
              "type": "null"
            }
          }
        },
        "then": {
          "required": ["lastRotatedReason"]
        }
      }
    }
  }
}
