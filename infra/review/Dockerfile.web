# Review-stack web image: the localized production bundle behind nginx, with the
# app-origin policy applied per response.
#
# Built from the release tree by scripts/review/deploy.sh (compose build):
#   docker build -f infra/review/Dockerfile.web -t evidgate-review-web:<sha> .
#
# Why an image instead of object storage + CDN (infra/README.md §Web bundle
# hosting): the review stack must be reproducible on one host with no cloud
# account. It serves the bundle same-origin with the Api, which is what the app
# expects — XSRF is skipped silently when the Api origin differs.
#
# Pins (both manifest-list digests, resolved 2026-11-02 from registry-1.docker.io
# with Accept: application/vnd.oci.image.index.v1+json and the
# Docker-Content-Digest header; recorded in infra/README.md):
#   builder  node:26.13.0-bookworm-slim  matches .nvmrc / engines ">=26 <27"
#   runtime  nginxinc/nginx-unprivileged:1.29.8-alpine
#            (runs as UID 101 on 8080: no privileged port, no root)
# check-pins.sh fails when either loses its digest.

FROM --platform=$BUILDPLATFORM node:26.13.0-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9 AS build

# The CSP's connect-src extension is part of the served document, so it is baked
# here: deploy.sh passes --public-origin through this build arg, and a deploy to
# a different origin rebuilds the image.
ARG EVIDGATE_REVIEW_PUBLIC_ORIGIN=

WORKDIR /src

# npm ci needs the root manifest, the lockfile and every workspace manifest, and
# nothing else: the dependency layer stays valid while application sources
# change. --ignore-scripts: the root `prepare` script installs husky hooks,
# which a build container has neither git nor a use for.
COPY package.json package-lock.json .npmrc ./
COPY apps/web/package.json apps/web/
COPY packages/ packages/
RUN npm ci --ignore-scripts

COPY tsconfig.base.json tsconfig.json ./
COPY apps/web/ apps/web/
# The app build's fixture-leak gate cross-checks against this corpus and fails
# without it; it is a build input only and never reaches the final stage.
COPY fixtures/web-api/ fixtures/web-api/
COPY infra/review/ infra/review/

# The repository's own build chain: `tsc -b tsconfig.json` emits the workspace
# libraries the app imports, then the web workspace's production build (which
# also runs its bundle-budget and fixture-leak checks). `localize: ["en","vi"]`
# writes dist/browser/<locale>/ with that locale's own <base href>.
RUN npx tsc -b tsconfig.json && npm run build -w apps/web

# The nginx header snippet is generated from apps/web/scripts/csp.mjs so the
# policy has one source; see generate-nginx-headers.mjs for the nonce handoff.
RUN EVIDGATE_REVIEW_PUBLIC_ORIGIN="$EVIDGATE_REVIEW_PUBLIC_ORIGIN" \
    node infra/review/generate-nginx-headers.mjs --out /out/security-headers.conf

FROM nginxinc/nginx-unprivileged:1.29.8-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6 AS runtime

# Root-owned and world-readable, as infra/docker/Dockerfile.worker requires: the
# nginx uid reads the tree but cannot unlink or replace a file in it.
USER root
COPY --from=build /src/apps/web/dist/browser /usr/share/nginx/html
COPY infra/review/nginx/nginx.conf /etc/nginx/nginx.conf
COPY infra/review/web-start.sh /usr/local/bin/evidgate-web-start
COPY --from=build /out/security-headers.conf /etc/nginx/snippets/security-headers.conf
# The image's own default server would answer on the same port for unknown
# names; this file replaces it with the single review server block.
RUN rm -f /etc/nginx/conf.d/default.conf

USER 101:101

EXPOSE 8080

# The base image's entrypoint scripts exist to template /etc/nginx/conf.d at
# start. This image ships a finished configuration, writes only the auth files
# under /tmp, and runs with a read-only rootfs, so they would write nowhere.
#
# The start script writes /tmp/evidgate/{auth.conf,htpasswd} from the basic-auth
# environment and then execs nginx; it exits non-zero (never serving) when auth
# is required but unset, which is how a quick tunnel stays authenticated.
ENTRYPOINT ["/bin/sh", "/usr/local/bin/evidgate-web-start"]
CMD []
