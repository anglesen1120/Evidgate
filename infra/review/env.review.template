# Evidgate review-stack environment template.
#
# scripts/review/deploy.sh copies this file to $HOME/evidgate-review/.env.review
# on the first deploy, replaces every __...__ placeholder with a fresh random
# value, chmods the result 600, and keeps it from then on: a later deploy reports
# "kept existing" and never rewrites it. Never commit the generated file, and
# never paste a real credential into this template.
#
# The file is read by `docker compose --env-file` only. The compose file
# interpolates these names into container environments and carries no value
# itself, so this file is the single place the review stack's credentials live.
#
# Nothing here may be reused from .env.dev, infra/seaweedfs/s3-config.json or
# the dev stack: review credentials are their own (00 §11).

# --- release and ingress -------------------------------------------------------
# Written by deploy.sh, not random: the exact git sha of the shipped release tree
# (it also tags the three built images) and the public origin the reviewers use.
# An empty origin is a valid --no-tunnel deploy; the CSP's connect-src then keeps
# only 'self'.
EVIDGATE_REVIEW_SHA=__EVIDGATE_REVIEW_SHA__
# The tag of the four locally built images (api, worker, migrator, web). It is the
# release sha unless a host receives images built elsewhere (`docker save|load`),
# in which case it must match the tag that was saved.
EVIDGATE_REVIEW_TAG=__EVIDGATE_REVIEW_SHA__
EVIDGATE_REVIEW_PUBLIC_ORIGIN=

# The remotely-managed tunnel's token, copied from the Cloudflare dashboard
# (Zero Trust -> Networks -> Tunnels -> the tunnel -> Install connector). Empty is
# allowed for --no-tunnel: compose passes it through and the tunnel profile's
# cloudflared container then exits with its own error, so a tunnel deploy without
# a token is refused by deploy.sh, not silently left without ingress.
CLOUDFLARE_TUNNEL_TOKEN=

# Loopback ports for the two local profiles (never reachable off-host).
EVIDGATE_REVIEW_LOCAL_PORT=8088
EVIDGATE_REVIEW_API_PORT=18080

COMPOSE_PROJECT_NAME=evidgate-review

# --- ingress mode and basic auth ----------------------------------------------
# Tunnel mode. token: `--profile tunnel`, the token below, and a hostname set in
# the Cloudflare dashboard. quick: `--profile tunnel-quick`, an ephemeral
# *.trycloudflare.com URL, no token, and basic auth forced on. deploy.sh passes
# the chosen mode to compose; compose hands it to the web container, which
# refuses to serve a quick tunnel without credentials.
EVIDGATE_REVIEW_TUNNEL_MODE=token

# Basic auth on every path of the web container (static files and /v1/ alike).
# required: refuse to start without the two keys below. optional: serve without
# them, but enforce them as soon as they are set. Quick mode is always required.
EVIDGATE_REVIEW_BASIC_AUTH=optional
EVIDGATE_REVIEW_BASIC_AUTH_USER=reviewer
# apr1 hash of the password (openssl passwd -apr1). Single-quoted on purpose:
# compose leaves a single-quoted value literal, so $apr1$ survives the env file,
# and the container start script reads the variable directly (never envsubst).
EVIDGATE_REVIEW_BASIC_AUTH_HASH='__EVIDGATE_REVIEW_BASIC_AUTH_HASH__'
# The plaintext password, for the owner to hand to reviewers. No container ever
# receives it: compose interpolates only the user and the hash.
EVIDGATE_REVIEW_BASIC_AUTH_PASSWORD=__EVIDGATE_REVIEW_BASIC_AUTH_PASSWORD__

# --- database: bootstrap superuser (the app never uses it) ---------------------
EVIDGATE_DB_SUPERUSER_PASSWORD=__EVIDGATE_DB_SUPERUSER_PASSWORD__

# --- database roles: owner migrates, app serves, operator reads, ---
# --- worker_sched sweeps ------------------------------------------------------
EVIDGATE_OWNER_PASSWORD=__EVIDGATE_OWNER_PASSWORD__
EVIDGATE_APP_PASSWORD=__EVIDGATE_APP_PASSWORD__
EVIDGATE_OPERATOR_PASSWORD=__EVIDGATE_OPERATOR_PASSWORD__
EVIDGATE_WORKER_SCHED_PASSWORD=__EVIDGATE_WORKER_SCHED_PASSWORD__

# --- connection strings: container names, never a host port -------------------
# Api and Worker use the app role (subject to RLS); the Migrator uses the owner
# role and is the only writer of public.schema_migration. A password containing
# ';' or '"' must be quoted inside the value (Npgsql's quoted form).
EVIDGATE__DATABASE__CONNECTIONSTRING='Host=postgres;Port=5432;Database=evidgate;Username=evidgate_app;Password=__EVIDGATE_APP_PASSWORD__'
EVIDGATE_MIGRATOR__CONNECTIONSTRING='Host=postgres;Port=5432;Database=evidgate;Username=evidgate_owner;Password=__EVIDGATE_OWNER_PASSWORD__'
EVIDGATE__TASKS__SWEEPCONNECTIONSTRING='Host=postgres;Port=5432;Database=evidgate;Username=evidgate_worker_sched;Password=__EVIDGATE_WORKER_SCHED_PASSWORD__'

# --- run cancel windows: required at boot, no option default -------------------
# Both are measured from the accepted cancel request; KILLDELAY is also the
# available_at of the durable kill task, so it must be at least SOFTSTOPDELAY.
EVIDGATE__RUNS__CANCEL__SOFTSTOPDELAY=00:00:30
EVIDGATE__RUNS__CANCEL__KILLDELAY=00:02:00

# --- object storage: the review SeaweedFS identity ----------------------------
# deploy.sh generates both; the seaweedfs container builds its own identity file
# from them, so there is no committed JSON to keep in step with (unlike the dev
# stack, which must match the 01.8.1-T1 parity fixture).
EVIDGATE_S3_ACCESS_KEY=__EVIDGATE_S3_ACCESS_KEY__
EVIDGATE_S3_SECRET_KEY=__EVIDGATE_S3_SECRET_KEY__

# --- the CI key pair (minted ingest tokens) -----------------------------------
# Base64, 32 bytes and 48 bytes. EVIDGATE__CI__PEPPER is required for
# `seed-dev --with-token`; both are required for POST /v1/ci/token.
EVIDGATE__CI__PEPPER=__EVIDGATE__CI__PEPPER__
EVIDGATE__CI__SIGNINGKEY=__EVIDGATE__CI__SIGNINGKEY__

# --- the Development-only sign-in lane (POST /v1/dev/session) -----------------
# Both keys are declared here because the Api maps that route only when the
# environment is Development and both are present. The reviewers' sign-in uses
# this secret; nothing else in the stack reads it.
EVIDGATE__DEVLOGIN__ENABLED=true
EVIDGATE__DEVLOGIN__SECRET=__EVIDGATE__DEVLOGIN__SECRET__

# --- the session pepper -------------------------------------------------------
# Base64, 32 bytes. The session cookie value is never stored: the row keeps
# HMAC-SHA256(pepper, value). Absent, every route that mints a session answers
# 503 `unavailable`.
EVIDGATE__SESSION__PEPPER=__EVIDGATE__SESSION__PEPPER__
